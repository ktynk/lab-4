#include <stdio.h>
#include <math.h>
#include <string.h>

int main()
{
    char symbols[11];
    int z;
   
    printf("vvedite elementi 10 ");
    for (z = 0; z < 10; z++)
    {
        scanf_s("%c", &symbols[z]);
        //if(symbols=='Z') break;
    }
    printf("ne povtoraytsa: ");

    for (int i = 0; i < 10; i++) {
        for (int a = 1 + i; a < 10; a++) {
            if (symbols[i] == symbols[a]) {
                printf("мусор");
                return 1;
            }
            else if (symbols[i] != symbols[a])
                printf("%c", symbols[i]);
        }
       
    }
    return 0;
}
